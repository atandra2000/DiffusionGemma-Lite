  "cards": [
    {
      "dot": "cyan",
      "title": "Training & Optimization",
      "items": [
        "Streams flat 4096-token windows across 50M-token binary shards with zero AR +1 offset.",
        "Uniform corruption replaces tokens with random vocabulary entries via cosine schedule ᾱ(t) = cos²(π/2·t/T).",
        "Chunked x₀ cross-entropy evaluates fp32 logsumexp per chunk, avoiding full (B,T,V) logits (~6.6 GB down to ~4.4 GB)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Architecture & Inference",
      "items": [
        "Attention is causal across canvases and bidirectional within, accelerated by FlexAttention.",
        "Sampler begins from uniform noise; positions commit under unchanged-or-stronger rule without overwriting.",
        "Committed canvases are re-encoded under an all-ones decode mask and appended to the KV cache with adaptive stopping."
      ]
    }
  ]
