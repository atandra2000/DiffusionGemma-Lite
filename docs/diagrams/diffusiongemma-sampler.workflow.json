{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "DiffusionGemma Canvas Sampling Loop",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "init",
      "label": "Context & KV Cache"
    },
    {
      "id": "denoise",
      "label": "Block Diffusion Denoising (T..1)"
    },
    {
      "id": "finalize",
      "label": "Canvas Finalization & Chain",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "prompt",
    "kv_cache",
    "mask_gen",
    "backbone",
    "posterior",
    "anneal",
    "entropy_check",
    "reencode",
    "append_kv"
  ],
  "nodes": [
    {
      "id": "prompt",
      "lane": "init",
      "col": 0,
      "type": "external",
      "label": "Prompt Prefix",
      "sublabel": "context tokens",
      "width": 120,
      "height": 48
    },
    {
      "id": "kv_cache",
      "lane": "init",
      "col": 1,
      "type": "database",
      "label": "Prior KV Cache",
      "sublabel": "cached canvas blocks",
      "width": 130,
      "height": 48
    },
    {
      "id": "mask_gen",
      "lane": "init",
      "col": 2,
      "type": "security",
      "label": "Decode Mask",
      "sublabel": "prefix + canvas visible",
      "width": 130,
      "height": 48
    },
    {
      "id": "append_kv",
      "lane": "init",
      "col": 5,
      "type": "database",
      "label": "Append KV Cache",
      "sublabel": "chain next canvas",
      "width": 130,
      "height": 48
    },
    {
      "id": "noise_init",
      "lane": "denoise",
      "col": 1,
      "type": "external",
      "label": "Uniform Noise xT",
      "sublabel": "256 tokens \u00b7 pure noise",
      "width": 130,
      "height": 48
    },
    {
      "id": "backbone",
      "lane": "denoise",
      "col": 2,
      "type": "backend",
      "label": "Transformer Fwd",
      "sublabel": "24L \u00b7 GQA 16/4 \u00b7 d=1024",
      "width": 130,
      "height": 48
    },
    {
      "id": "posterior",
      "lane": "denoise",
      "col": 3,
      "type": "backend",
      "label": "x\u03020 Posterior",
      "sublabel": "logits over 50,257 IDs",
      "width": 125,
      "height": 48
    },
    {
      "id": "anneal",
      "lane": "denoise",
      "col": 4,
      "type": "backend",
      "label": "Anneal & Commit",
      "sublabel": "\u03c4(t) \u00b7 monotonic commit",
      "width": 135,
      "height": 48
    },
    {
      "id": "entropy_check",
      "lane": "denoise",
      "col": 5,
      "type": "backend",
      "label": "Entropy Check",
      "sublabel": "all-position mean H",
      "width": 125,
      "height": 48
    },
    {
      "id": "early_exit",
      "lane": "finalize",
      "col": 4,
      "type": "security",
      "label": "Stable low entropy",
      "sublabel": "H < threshold twice",
      "width": 125,
      "height": 48
    },
    {
      "id": "reencode",
      "lane": "finalize",
      "col": 5,
      "type": "backend",
      "label": "All-Ones Pass",
      "sublabel": "re-encode final tokens",
      "width": 125,
      "height": 48
    },
    {
      "id": "done",
      "lane": "init",
      "col": 4,
      "type": "external",
      "label": "Return tokens",
      "sublabel": "trim to requested length",
      "width": 150,
      "height": 48
    }
  ],
  "edges": [
    {
      "id": "prompt-kv",
      "from": "prompt",
      "to": "kv_cache",
      "label": "prefix KV",
      "variant": "emphasis"
    },
    {
      "id": "kv-mask",
      "from": "kv_cache",
      "to": "mask_gen"
    },
    {
      "id": "mask-backbone",
      "from": "mask_gen",
      "to": "backbone",
      "label": "block mask"
    },
    {
      "id": "noise-backbone",
      "from": "noise_init",
      "to": "backbone",
      "label": "noisy xt",
      "variant": "emphasis"
    },
    {
      "id": "backbone-posterior",
      "from": "backbone",
      "to": "posterior",
      "label": "logits",
      "variant": "emphasis"
    },
    {
      "id": "posterior-anneal",
      "from": "posterior",
      "to": "anneal",
      "label": "temp \u03c4",
      "variant": "emphasis"
    },
    {
      "id": "anneal-entropy",
      "from": "anneal",
      "to": "entropy_check",
      "label": "committed xt",
      "variant": "emphasis"
    },
    {
      "id": "entropy-reencode",
      "from": "entropy_check",
      "to": "reencode",
      "label": "step budget reached",
      "variant": "emphasis"
    },
    {
      "id": "entropy-exit",
      "from": "entropy_check",
      "to": "early_exit",
      "label": "2 low-H iterations",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "exit-reencode",
      "from": "early_exit",
      "to": "reencode",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "reencode-append",
      "from": "reencode",
      "to": "append_kv",
      "label": "final KV",
      "variant": "emphasis"
    },
    {
      "id": "entropy_check-backbone",
      "from": "entropy_check",
      "to": "backbone",
      "role": "return",
      "variant": "default",
      "label": "continue denoising"
    },
    {
      "id": "append_kv-noise_init",
      "from": "append_kv",
      "to": "noise_init",
      "role": "return",
      "variant": "default",
      "label": "next canvas"
    },
    {
      "id": "append_kv-done",
      "from": "append_kv",
      "to": "done",
      "role": "branch",
      "variant": "default",
      "label": "budget filled"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Temperature and commitment",
      "items": [
        "inference/generate.py:BlockDiffusionSampler.denoise_canvas uses tau = .8 - (.8 - .4) \u00d7 k/T, k=0..T-1.",
        "Only newly committed positions receive sampled predictions. Old committed tokens are immutable, others redraw uniform noise."
      ]
    },
    {
      "dot": "amber",
      "title": "Stopping and cache",
      "items": [
        "Entropy is averaged across all positions and batch members. Adaptive stopping requires strict H < threshold for two consecutive iterations by default.",
        "Finalized canvas re-encoding sees the entire cached prefix and active canvas. It is not token-causal within that canvas."
      ]
    },
    {
      "dot": "slate",
      "title": "Provenance",
      "items": [
        "SamplerConfig defaults: T=32, temperature .8/.4, stability_steps=2. No measured throughput or trained stopping gain.",
        "configs/pretrain_a100_380m.yaml at 83acb7cc6e3a597800cb6ae3be8ad673b100e6f3."
      ]
    }
  ]
}
