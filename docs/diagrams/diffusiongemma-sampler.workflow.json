  "cards": [
    {
      "dot": "cyan",
      "title": "Block Diffusion Generation",
      "items": [
        "Generation advances in 256-token canvas blocks; each canvas begins from uniform random vocabulary noise (never q_sample).",
        "Tokens are denoised over T discrete reverse diffusion steps with temperature annealing τ(t) = τ0 · (t/T).",
        "Committed tokens follow an unchanged-or-stronger rule: positions retain decisions unless confidence strictly increases."
      ]
    },
    {
      "dot": "emerald",
      "title": "Adaptive Stopping & Cache Chaining",
      "items": [
        "Adaptive stopping monitors posterior entropy across uncommitted tokens, halting step iterations when confidence saturates.",
        "Finalized canvas tokens undergo an all-ones causal re-encode pass to populate KV cache entries for downstream blocks."
      ]
    }
  ]
