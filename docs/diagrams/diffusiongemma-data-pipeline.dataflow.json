  "cards": [
    {
      "dot": "cyan",
      "title": "Shard & Windowing Contract",
      "items": [
        "160 binary shards holding 50M uint32 GPT-2 tokens each (8.0B total tokens), accessed via zero-copy mmap.",
        "Sequences are sliced into contiguous 4096-token windows (16 canvases × 256 tokens) with zero AR +1 offset.",
        "Windows cross document boundaries with EOS separation, but never cross shard boundaries."
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic Shuffler & Training Target",
      "items": [
        "ShuffledRangeSampler maintains an epoch-seeded permutation and epoch/cursor state for exact resume reproduction.",
        "Dataset emits clean target tokens x0; trainer handles corruption to xt and scores the posterior against clean x0."
      ]
    }
  ]
