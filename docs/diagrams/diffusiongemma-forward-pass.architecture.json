    { "dot": "cyan", "title": "Training", "items": [
      "Each 256-token canvas draws its own timestep t ~ U{1..16}; q_sample corrupts x₀ directly under the cosine schedule.",
      "The objective is chunked x₀ cross-entropy: fp32 logsumexp per vocab chunk — full (B,T,V) logits are never materialized.",
      "With probability 0.5 a no-grad pre-pass re-embeds its own posterior; the second pass receives it detached."
    ] },
    { "dot": "emerald", "title": "Sampling", "items": [
      "Each in-flight canvas starts from pure uniform token noise — never q_sample.",
      "Every posterior commits unchanged-or-stronger positions; only uncommitted positions redraw.",
      "A finalized canvas is re-encoded under an all-ones decode mask and appended to the KV cache."
    ] }
