{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "DiffusionGemma Training and Recovery",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "micro",
      "label": "Micro-batch computation"
    },
    {
      "id": "update",
      "label": "Optimizer and recovery"
    },
    {
      "id": "control",
      "label": "Continue or finish"
    }
  ],
  "mainPath": [
    "fetch",
    "loss",
    "finite",
    "bwd",
    "boundary",
    "commit",
    "cadence"
  ],
  "nodes": [
    {
      "id": "fetch",
      "type": "external",
      "label": "Fetch clean x0",
      "sublabel": "16 \u00d7 4096 tokens",
      "lane": "micro",
      "col": 0,
      "width": 150,
      "height": 58
    },
    {
      "id": "loss",
      "type": "backend",
      "label": "Corrupt + forward",
      "sublabel": "self-cond + chunked CE",
      "lane": "micro",
      "col": 1,
      "width": 150,
      "height": 58
    },
    {
      "id": "finite",
      "type": "security",
      "label": "Finite loss?",
      "sublabel": "configured guard",
      "lane": "micro",
      "col": 2,
      "width": 150,
      "height": 58
    },
    {
      "id": "bwd",
      "type": "backend",
      "label": "Backward",
      "sublabel": "loss / 2",
      "lane": "micro",
      "col": 3,
      "width": 150,
      "height": 58
    },
    {
      "id": "boundary",
      "type": "security",
      "label": "Update due?",
      "sublabel": "every 2 micro-steps",
      "lane": "micro",
      "col": 4,
      "width": 150,
      "height": 58
    },
    {
      "id": "recovery",
      "type": "security",
      "label": "Skip / recovery",
      "sublabel": "clear grads, count faults",
      "lane": "update",
      "col": 2,
      "width": 150,
      "height": 58
    },
    {
      "id": "commit",
      "type": "backend",
      "label": "Clip + AdamW",
      "sublabel": "scheduler, zero grad",
      "lane": "update",
      "col": 4,
      "width": 150,
      "height": 58
    },
    {
      "id": "cadence",
      "type": "backend",
      "label": "Log / save",
      "sublabel": "optimizer-step cadence",
      "lane": "update",
      "col": 5,
      "width": 150,
      "height": 58
    },
    {
      "id": "next",
      "type": "security",
      "label": "More updates?",
      "sublabel": "stop at configured limit",
      "lane": "control",
      "col": 0,
      "width": 150,
      "height": 58
    },
    {
      "id": "final",
      "type": "database",
      "label": "Final checkpoint",
      "sublabel": "direct three-file write",
      "lane": "control",
      "col": 1,
      "width": 150,
      "height": 58
    },
    {
      "id": "abort",
      "type": "external",
      "label": "Abort",
      "sublabel": "no recovery checkpoint",
      "lane": "update",
      "col": 3,
      "width": 150,
      "height": 58
    },
    {
      "id": "ckpt",
      "type": "database",
      "label": "Checkpoint files",
      "sublabel": "weights + optim + JSON",
      "lane": "control",
      "col": 5,
      "width": 150,
      "height": 58
    }
  ],
  "edges": [
    {
      "id": "fetch-loss",
      "from": "fetch",
      "to": "loss",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "loss-finite",
      "from": "loss",
      "to": "finite",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "finite-bwd",
      "from": "finite",
      "to": "bwd",
      "role": "main",
      "variant": "default",
      "label": "yes"
    },
    {
      "id": "finite-recovery",
      "from": "finite",
      "to": "recovery",
      "role": "error",
      "variant": "security",
      "label": "no"
    },
    {
      "id": "recovery-next",
      "from": "recovery",
      "to": "next",
      "role": "return",
      "variant": "default",
      "label": "skip / restored"
    },
    {
      "id": "recovery-abort",
      "from": "recovery",
      "to": "abort",
      "role": "error",
      "variant": "security",
      "label": "5 faults, no save"
    },
    {
      "id": "bwd-boundary",
      "from": "bwd",
      "to": "boundary",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "boundary-commit",
      "from": "boundary",
      "to": "commit",
      "role": "main",
      "variant": "default",
      "label": "yes"
    },
    {
      "id": "boundary-next",
      "from": "boundary",
      "to": "next",
      "role": "return",
      "variant": "default",
      "label": "no"
    },
    {
      "id": "commit-cadence",
      "from": "commit",
      "to": "cadence",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "cadence-next",
      "from": "cadence",
      "to": "next",
      "role": "return",
      "variant": "default"
    },
    {
      "id": "cadence-ckpt",
      "from": "cadence",
      "to": "ckpt",
      "role": "branch",
      "variant": "dashed",
      "label": "save due"
    },
    {
      "id": "next-fetch",
      "from": "next",
      "to": "fetch",
      "role": "return",
      "variant": "default",
      "label": "yes"
    },
    {
      "id": "next-final",
      "from": "next",
      "to": "final",
      "role": "branch",
      "variant": "default",
      "label": "no"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Configured training",
      "items": [
        "DiffusionGemma initialization, not Gemma2 weights. Chunk width 4096 at micro-batch 16, accumulation 2.",
        "training/pretrain.py:Pretrainer.train has no validation transition. Saves/logs key off optimizer steps, but may repeat across micro-steps."
      ]
    },
    {
      "dot": "amber",
      "title": "Recovery limits",
      "items": [
        "Five consecutive nonfinite micro-batches restore the latest complete checkpoint or abort if none exists.",
        "utils/checkpoint.py:CheckpointManager.save writes three files directly, not atomic rename. RNG and pending gradients are not saved."
      ]
    },
    {
      "dot": "slate",
      "title": "Source and resume",
      "items": [
        "Per-step seeded draws and fixed-order offsets support reproducibility. _micro_count is reconstructed from optimizer count, so skipped batches complicate exact resume.",
        "configs/pretrain_a100_380m.yaml at 83acb7cc6e3a597800cb6ae3be8ad673b100e6f3."
      ]
    }
  ]
}
